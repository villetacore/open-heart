        "id": "hub_stranger_intro",
        "lines": [
            /*[0]*/ {
                "portrait": "stranger",
                "speaker": {
                    "en": "Echo",
                    "ru": "Эхо",
                },
                "text": {
                    "en": "They call me Echo here. My real name remained on a depth that no longer exists.",
                    "ru": "Здесь меня зовут Эхо. Настоящее имя осталось на ярусе, которого больше нет.",
                },
            },
            /*[1]*/ {
                "portrait": "stranger",
                "speaker": {
                    "en": "Echo",
                    "ru": "Эхо",
                },
                "text": {
                    "en": "The Heart remembers those who look at it. Do not let it finish your portrait.",
                    "ru": "Сердце запоминает тех, кто смотрит на него. Не позволяй ему закончить твой портрет.",
                },
            },
        ],
    },
