        "id": "hub_guard_intro",
        "lines": [
            /*[0]*/ {
                "portrait": "guard",
                "speaker": {
                    "en": "Guard Drake",
                    "ru": "Охранник Дрейк",
                },
                "text": {
                    "en": "Drake, north gate. I do not forbid descents; I only count those who return.",
                    "ru": "Дрейк, северные врата. Я не запрещаю спускаться — только считаю тех, кто вернулся.",
                },
            },
            /*[1]*/ {
                "portrait": "guard",
                "speaker": {
                    "en": "Guard Drake",
                    "ru": "Охранник Дрейк",
                },
                "text": {
                    "en": "Do not lead a pack to the gate. If pursued, circle through the eastern bridge.",
                    "ru": "Не приводи стаю к воротам. Если преследуют — сделай круг через восточный мост.",
                },
            },
        ],
    },
    /*[31]*/ {
        "choices": [
            /*[0]*/ {
                "effects": [
                    /*[0]*/ {
                        "kind": "flash",
                        "text": {
                            "en": "Drake does not answer.",
                            "ru": "Дрейк не отвечает.",
                        },
                    },
                ],
                "text": {
                    "en": "What is it counting?",
                    "ru": "Кого оно считает?",
                },
            },
            /*[1]*/ {
                "text": {
                    "en": "Check your gear and leave.",
                    "ru": "Проверить снаряжение и уйти.",
                },
            },
        ],
