        "id": "neighbors_yves_1_complete",
        "lines": [
            /*[0]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "We\'ll leave room for roses and ordinary grass. A shared courtyard needn\'t reflect only my taste.",
                    "ru": "Оставим место и розам, и простой траве. Если двор общий, он не обязан целиком походить на мой вкус.",
                },
            },
            /*[1]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "Thank you for seeing it through. Here is your payment.",
                    "ru": "Спасибо, что довёл дело до конца. Вот обещанная плата.",
                },
            },
        ],
    },
    /*[118]*/ {
        "choices": [
            /*[0]*/ {
                "effects": [
                    /*[0]*/ {
                        "desc": {
                            "en": "Clear catacomb depth three and return to Yves. Earlier completion counts.",
                            "ru": "Пройди третий ярус катакомб и вернись к Иву. Уже пройденная глубина учитывается.",
