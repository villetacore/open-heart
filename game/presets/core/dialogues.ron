        "id": "hub_sofia_intro",
        "lines": [
            /*[0]*/ {
                "portrait": "sofia",
                "speaker": {
                    "en": "Sofia",
                    "ru": "София",
                },
                "text": {
                    "en": "I assign housing, shifts and debts. The quarter is held together not by walls, but by who opens a door for whom.",
                    "ru": "Я распределяю жильё, смены и долги. В квартале всё держится не на стенах, а на том, кто кому откроет дверь.",
                },
            },
            /*[1]*/ {
                "portrait": "sofia",
                "speaker": {
                    "en": "Sofia",
                    "ru": "София",
                },
                "text": {
                    "en": "Sofia. Do not promise people anything you cannot bring back from below.",
                    "ru": "София. Не обещай людям то, что не сможешь принести из глубины.",
                },
            },
        ],
    },
    /*[29]*/ {
        "choices": [
            /*[0]*/ {
                "effects": [
                    /*[0]*/ {
                        "kind": "rel",
                        "npc": "sofia",
                        "value": 3,
                    },
                ],
                "text": {
                    "en": "Let them know the streets are still ours.",
                    "ru": "Пусть знают, что улицы ещё наши.",
                },
            },
            /*[1]*/ {
                "text": {
                    "en": "Light attracts enemies.",
                    "ru": "Свет привлекает врагов.",
                },
            },
        ],
