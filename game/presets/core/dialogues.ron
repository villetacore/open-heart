        "id": "hub_elena_intro",
        "lines": [
            /*[0]*/ {
                "portrait": "elena",
                "speaker": {
                    "en": "Elena",
                    "ru": "Елена",
                },
                "text": {
                    "en": "I listen to radio noise from the catacombs. Most of it is interference. The rest sounds too much like speech.",
                    "ru": "Я слушаю радиошум катакомб. Большая часть — помехи. Остальное слишком похоже на речь.",
                },
            },
            /*[1]*/ {
                "portrait": "elena",
                "speaker": {
                    "en": "Elena",
                    "ru": "Елена",
                },
                "text": {
                    "en": "Elena. If you find a working transmitter, do not activate it below.",
                    "ru": "Елена. Если найдёшь работающий передатчик, не включай его внизу.",
                },
            },
        ],
    },
    /*[27]*/ {
        "choices": [
            /*[0]*/ {
                "effects": [
                    /*[0]*/ {
                        "kind": "rel",
                        "npc": "elena",
                        "value": 3,
                    },
                ],
                "text": {
                    "en": "Leave a recording of your route.",
                    "ru": "Оставить запись своего маршрута.",
                },
            },
            /*[1]*/ {
                "text": {
                    "en": "Silence is good news.",
                    "ru": "Тишина — хорошая новость.",
                },
            },
        ],
        "id": "hub_elena_repeat",
        "lines": [
            /*[0]*/ {
                "portrait": "elena",
                "speaker": {
                    "en": "Elena",
                    "ru": "Елена",
                },
                "text": {
                    "en": "The signal is silent today. I do not like it when it learns to be cautious.",
                    "ru": "Сегодня сигнал молчит. Мне не нравится, когда он учится быть осторожным.",
                },
            },
        ],
    },
    /*[28]*/ {
        "choices": [
            /*[0]*/ {
