        "id": "hub_merchant_intro",
        "lines": [
            /*[0]*/ {
                "portrait": "merchant",
                "speaker": {
                    "en": "Merchant Rook",
                    "ru": "Торговец Рук",
                },
                "text": {
                    "en": "Rook. I buy anything that does not whisper after midnight. Whispering goods are half price.",
                    "ru": "Рук. Покупаю всё, что не шепчет после полуночи. То, что шепчет, беру за полцены.",
                },
            },
            /*[1]*/ {
                "portrait": "merchant",
                "speaker": {
                    "en": "Merchant Rook",
                    "ru": "Торговец Рук",
                },
                "text": {
                    "en": "Ammunition on the left, medicine on the right, cursed souvenirs under the counter—do not touch.",
                    "ru": "Патроны слева, лекарства справа, проклятые сувениры под прилавком — не трогать.",
                },
            },
        ],
