        "id": "hub_stranger_tyrant_aftermath",
        "lines": [
            /*[0]*/ {
                "portrait": "stranger",
                "speaker": {
                    "en": "Stranger",
                    "ru": "Незнакомец",
                },
                "text": {
                    "en": "You killed the Tyrant, but the Heart did not fall silent. It changed the question: once it asked who would enter. Now it asks who will remain.",
                    "ru": "Ты убил Тирана, но Сердце не замолчало. Оно сменило вопрос: раньше спрашивало, кто войдёт. Теперь — кто останется.",
                },
            },
        ],
    },
    /*[55]*/ {
        "choices": [
            /*[0]*/ {
                "next": "atelier_work",
                "text": {
                    "en": "How can I help?",
                    "ru": "Чем помочь ателье?",
                },
            },
            /*[1]*/ {
