        "id": "hub_elena_oracle_aftermath",
        "lines": [
            /*[0]*/ {
                "portrait": "scientist",
                "speaker": {
                    "en": "Elena",
                    "ru": "Елена",
                },
                "text": {
                    "en": "After the Oracle died, the interference resolved into a voice. It repeats no prophecy—only a list of former victims.",
                    "ru": "После смерти Оракула помехи сложились в голос. Он повторяет не пророчество, а список прежних жертв.",
                },
            },
        ],
