        "id": "hub_vale_archive_aftermath",
        "lines": [
            /*[0]*/ {
                "portrait": "vale",
                "speaker": {
                    "en": "Vale",
                    "ru": "Вейл",
                },
                "text": {
                    "en": "The Archive Sentinel is gone, and three corridors returned to the old maps. A fourth appeared for the first time.",
                    "ru": "Страж Архива исчез, и три коридора вернулись на старые карты. Четвёртый появился впервые.",
                },
            },
        ],
    },
    /*[54]*/ {
