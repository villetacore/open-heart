                    },
                ],
                "text": {
                    "en": "I will gather what I can.",
                    "ru": "Соберу всё, что найду.",
                },
            },
            /*[1]*/ {
                "text": {
                    "en": "I have no room in my pack right now.",
                    "ru": "Сейчас у меня нет места в рюкзаке.",
