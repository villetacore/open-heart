        "lines": [
            /*[0]*/ {
                "portrait": "sofia",
                "speaker": {
                    "en": "Sofia",
                    "ru": "София",
                },
                "text": {
                    "en": "Since your expeditions, the northern shelter leaves its lights on at night again. That is worth more than gold.",
                    "ru": "После твоих вылазок северное убежище снова оставляет свет на ночь. Это дороже золота.",
                },
            },
        ],
    },
