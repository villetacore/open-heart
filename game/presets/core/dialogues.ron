            /*[0]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "I want a living flowerbed, not a beauty contest. Let\'s talk before picking up shovels.",
                    "ru": "Хочу живую клумбу, а не спор о том, чьи растения красивее. Начнём с разговора, пока не взялись за лопаты.",
                },
            },
            /*[1]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "Talk to Ivo about flowers for the shared courtyard and return to Yves by the southern road.",
                    "ru": "Обсуди с Иво цветы для общего двора и вернись к Иву у южной дороги.",
                },
            },
        ],
    },
    /*[116]*/ {
        "choices": [
            /*[0]*/ {
                "text": {
                    "en": "I\'ll be back.",
                    "ru": "Вернусь позже.",
                },
            },
        ],
        "id": "neighbors_yves_1_progress",
        "lines": [
            /*[0]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "Talk to Ivo about flowers for the shared courtyard and return to Yves by the southern road.",
                    "ru": "Обсуди с Иво цветы для общего двора и вернись к Иву у южной дороги.",
                },
            },
            /*[1]*/ {
                "portrait": "yves",
                "speaker": {
                    "en": "Yves",
                    "ru": "Ив",
                },
                "text": {
                    "en": "Don\'t rush just for a report. I\'d rather you return in one piece.",
                    "ru": "Не торопись ради отчёта. Мне важнее, чтобы ты вернулся целым.",
                },
            },
        ],
    },
    /*[117]*/ {
        "choices": [
            /*[0]*/ {
